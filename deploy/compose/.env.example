# Copy to .env and choose a local-only password. Never commit .env.
ZM_BATON_DB_PASSWORD=change-me
# Authentication: local (the default) or required. Read docs/stage1/auth.md before changing it.
ZM_BATON_AUTH=local
# First-screen relay of permission requests and questions: on works only with ZM_BATON_AUTH=required
# (docs/stage1/sessions.md).
ZM_BATON_RELAY=off
